// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ROLES {
  TRAVELLER
  BUSDRIVER
  ADMIN
}

enum BUS_TYPE {
  AC
  NON_AC
  SLEEPER
  SEMI_SLEEPER
}

enum BOOKING_STATUS {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SEAT_STATUS {
  HELD
  BOOKED
  CANCELLED
  EXPIRED
}

enum HotelStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RoomType {
  STANDARD
  DELUXE
  SUPER_DELUXE
  SUITE
  FAMILY
}

model User {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String @unique
  password  String
  role      ROLES  @default(TRAVELLER)

  otp          String?
  otpExpiresAt DateTime?
  verified_At  DateTime?

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  tourPlaces    Tourplace[]    @relation("AdminTourPlaces")
  buses         Bus[]          @relation("DriverBus")
  tourBookings  TourBooking[]  @relation("TravellerTourBookings")
  busBookings   BusBooking[]   @relation("TravellerBusBookings")
  hotelBookings HotelBooking[] @relation("TravellerHotelBookings")
  hotelReviews  HotelReview[]
}

model Tourplace {
  id   String @id @default(uuid()) @db.Uuid
  name String

  adminId String @db.Uuid
  admin   User   @relation("AdminTourPlaces", fields: [adminId], references: [id])

  tourBookings TourBooking[]

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt
}

model TourBooking {
  id String @id @default(uuid()) @db.Uuid

  travellerId String @db.Uuid
  traveller   User   @relation("TravellerTourBookings", fields: [travellerId], references: [id])

  tourPlaceId String    @db.Uuid
  tourPlace   Tourplace @relation(fields: [tourPlaceId], references: [id])

  hotelBooking HotelBooking?
  busBookings  BusBooking[]

  status BOOKING_STATUS @default(PENDING)

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt
}

model Bus {
  id String @id @default(uuid()) @db.Uuid

  busNumber  String   @unique
  busType    BUS_TYPE
  totalSeats Int

  driverId String? @db.Uuid
  driver   User?   @relation("DriverBus", fields: [driverId], references: [id])

  from String
  to   String

  departureAt DateTime
  arrivalAt   DateTime

  bookings BusBooking[]

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt
}

model BusBooking {
  id String @id @default(uuid()) @db.Uuid

  travellerId String @db.Uuid
  traveller   User   @relation("TravellerBusBookings", fields: [travellerId], references: [id])

  busId String @db.Uuid
  bus   Bus    @relation(fields: [busId], references: [id])

  tourBookingId String      @db.Uuid
  tourBooking   TourBooking @relation(fields: [tourBookingId], references: [id])

  seatNumber String

  status SEAT_STATUS @default(HELD)

  holdUntil DateTime?

  paymentStatus PAYMENT_STATUS @default(PENDING)

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@unique([busId, seatNumber])
}

model Hotel {
  id          String  @id @default(uuid()) @db.Uuid
  osmId       String  @unique
  name        String
  description String?
  website     String?
  phone       String?

  address String?
  city    String
  state   String
  country String  @default("India")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  status HotelStatus @default(PENDING)

  rooms   HotelRoom[]
  reviews HotelReview[]

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@index([city, state])
  @@index([status])
}

model HotelRoom {
  id      String @id @default(uuid()) @db.Uuid
  hotelId String @db.Uuid

  roomType   RoomType
  roomName   String
  capacity   Int
  totalRooms Int
  amenities  String[]

  hotel    Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  prices   HotelPrice[]
  bookings HotelBooking[]

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@unique([hotelId, roomType])
  @@index([hotelId])
}

model HotelBooking {
  id String @id @default(uuid()) @db.Uuid

  travellerId String @db.Uuid
  traveller   User   @relation("TravellerHotelBookings", fields: [travellerId], references: [id])

  tourBookingId String      @unique @db.Uuid
  tourBooking   TourBooking @relation(fields: [tourBookingId], references: [id])

  roomId String    @db.Uuid
  room   HotelRoom @relation(fields: [roomId], references: [id])

  checkIn        DateTime
  checkOut       DateTime
  numberOfGuests Int
  numberOfRooms  Int      @default(1)

  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("INR")

  status        BOOKING_STATUS @default(PENDING)
  paymentStatus PAYMENT_STATUS @default(PENDING)

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@index([roomId, checkIn, checkOut])
  @@index([travellerId])
}

model HotelPrice {
  id     String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid

  pricePerNight Decimal @db.Decimal(10, 2)
  currency      String  @default("INR")

  validFrom DateTime
  validTo   DateTime

  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@index([roomId, validFrom, validTo])
}

model HotelReview {
  id      String @id @default(uuid()) @db.Uuid
  hotelId String @db.Uuid
  userId  String @db.Uuid

  rating  Int
  comment String?

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@unique([hotelId, userId])
  @@index([hotelId])
  @@index([userId])
}
